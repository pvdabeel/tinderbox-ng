# /etc/portage/package.env/00-tinderbox-ng-defaults -- shipped by
# tinderbox-ng bootstrap.
#
# Per-package environment overrides applied to every session inheriting
# from the baseline. Referenced env files live in /etc/portage/env/ and
# are shipped as baseline.env.* templates.
#
# Conventions:
#   * keep this file restricted to overrides needed for the matrix to
#     make forward progress;
#   * per-entry comment must explain WHY the override exists so the next
#     person reading this knows whether it can be removed.

# kate-addons 26.04.x: the rbql addon's CMakeLists links the versionless
# Qt::Qml target but nothing in the kate build tree ever calls
# find_package(Qt6Qml) in a scope visible to addons/rbql (Qt versionless
# targets are directory-scoped), so cmake generate always fails with
# 'Target "rbqlplugin" links to: Qt::Qml but the target was not found'
# (portage-ng#98, upstream kate packaging bug). Disable the rbql addon
# until upstream adds the missing find_package.
kde-apps/kate-addons tinderbox-ng-no-rbql.conf
